*********************************************************************
* MFS for MFSACHDV01
* Pacific National Bank — IMS/TM Message Format
*********************************************************************
         PRINT NOGEN
MFSACHDV01M  MSG   TYPE=INPUT,SOR=(MFSACHDV01I,IGNORE),
               NXT=MFSACHDV01O
         SEG
         MFLD  'FLD000',LTH=12,
               JUST=R
         MFLD  'FLD001',LTH=10,
               JUST=R
         MFLD  'FLD002',LTH=20,
               JUST=R
         MFLD  'FLD003',LTH=20,
               JUST=R
         MFLD  'FLD004',LTH=20,
               JUST=R
         MFLD  'FLD005',LTH=30,
               JUST=R
         MSGEND
*
MFSACHDV01O  MSG   TYPE=OUTPUT,SOR=(MFSACHDV01D,IGNORE),
               NXT=MFSACHDV01M
         SEG
         MFLD  'FLD000',LTH=12
         MFLD  'FLD001',LTH=10
         MFLD  'FLD002',LTH=20
         MFLD  'FLD003',LTH=20
         MFLD  'FLD004',LTH=20
         MFLD  'FLD005',LTH=30
         MSGEND
*
MFSACHDV01I  FMT
         DEV   TYPE=(3270,2),FEAT=(IGNORE),DSCA=X'0020'
         DIV   TYPE=INOUT
         DFLD  'FLD000',LTH=12,
               POS=(1,1),ATTR=(PROT,NUM)
         DFLD  'FLD001',LTH=10,
               POS=(1,15),ATTR=(PROT,NUM)
         DFLD  'FLD002',LTH=20,
               POS=(1,27),ATTR=(PROT,NUM)
         DFLD  'FLD003',LTH=20,
               POS=(1,49),ATTR=(PROT,NUM)
         DFLD  'FLD004',LTH=20,
               POS=(1,71),ATTR=(PROT,NUM)
         DFLD  'FLD005',LTH=30,
               POS=(2,13),ATTR=(PROT,NUM)
         FMTEND
         END
