*********************************************************************
* MFS for MFSGLDBV13
* Pacific National Bank — IMS/TM Message Format
*********************************************************************
         PRINT NOGEN
MFSGLDBV13M  MSG   TYPE=INPUT,SOR=(MFSGLDBV13I,IGNORE),
               NXT=MFSGLDBV13O
         SEG
         MFLD  'FLD000',LTH=30,
               JUST=R
         MFLD  'FLD001',LTH=20,
               JUST=R
         MFLD  'FLD002',LTH=8,
               JUST=L
         MFLD  'FLD003',LTH=16,
               JUST=L
         MFLD  'FLD004',LTH=8,
               JUST=L
         MFLD  'FLD005',LTH=12,
               JUST=L
         MFLD  'FLD006',LTH=40,
               JUST=L
         MFLD  'FLD007',LTH=40,
               JUST=R
         MSGEND
*
MFSGLDBV13O  MSG   TYPE=OUTPUT,SOR=(MFSGLDBV13D,IGNORE),
               NXT=MFSGLDBV13M
         SEG
         MFLD  'FLD000',LTH=30
         MFLD  'FLD001',LTH=20
         MFLD  'FLD002',LTH=8
         MFLD  'FLD003',LTH=16
         MFLD  'FLD004',LTH=8
         MFLD  'FLD005',LTH=12
         MFLD  'FLD006',LTH=40
         MFLD  'FLD007',LTH=40
         MSGEND
*
MFSGLDBV13I  FMT
         DEV   TYPE=(3270,2),FEAT=(IGNORE),DSCA=X'0020'
         DIV   TYPE=INOUT
         DFLD  'FLD000',LTH=30,
               POS=(1,1),ATTR=(PROT,NUM)
         DFLD  'FLD001',LTH=20,
               POS=(1,33),ATTR=(PROT,NUM)
         DFLD  'FLD002',LTH=8,
               POS=(1,55),ATTR=(PROT,NUM)
         DFLD  'FLD003',LTH=16,
               POS=(1,65),ATTR=(PROT,NUM)
         DFLD  'FLD004',LTH=8,
               POS=(2,3),ATTR=(PROT,NUM)
         DFLD  'FLD005',LTH=12,
               POS=(2,13),ATTR=(PROT,NUM)
         DFLD  'FLD006',LTH=40,
               POS=(2,27),ATTR=(PROT,NUM)
         DFLD  'FLD007',LTH=40,
               POS=(2,69),ATTR=(PROT,NUM)
         FMTEND
         END
