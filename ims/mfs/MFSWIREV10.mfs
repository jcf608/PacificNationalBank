*********************************************************************
* MFS for MFSWIREV10
* Pacific National Bank — IMS/TM Message Format
*********************************************************************
         PRINT NOGEN
MFSWIREV10M  MSG   TYPE=INPUT,SOR=(MFSWIREV10I,IGNORE),
               NXT=MFSWIREV10O
         SEG
         MFLD  'FLD000',LTH=20,
               JUST=L
         MFLD  'FLD001',LTH=16,
               JUST=R
         MFLD  'FLD002',LTH=30,
               JUST=R
         MFLD  'FLD003',LTH=16,
               JUST=L
         MFLD  'FLD004',LTH=40,
               JUST=R
         MSGEND
*
MFSWIREV10O  MSG   TYPE=OUTPUT,SOR=(MFSWIREV10D,IGNORE),
               NXT=MFSWIREV10M
         SEG
         MFLD  'FLD000',LTH=20
         MFLD  'FLD001',LTH=16
         MFLD  'FLD002',LTH=30
         MFLD  'FLD003',LTH=16
         MFLD  'FLD004',LTH=40
         MSGEND
*
MFSWIREV10I  FMT
         DEV   TYPE=(3270,2),FEAT=(IGNORE),DSCA=X'0020'
         DIV   TYPE=INOUT
         DFLD  'FLD000',LTH=20,
               POS=(1,1),ATTR=(PROT,NUM)
         DFLD  'FLD001',LTH=16,
               POS=(1,23),ATTR=(PROT,NUM)
         DFLD  'FLD002',LTH=30,
               POS=(1,41),ATTR=(PROT,NUM)
         DFLD  'FLD003',LTH=16,
               POS=(1,73),ATTR=(PROT,NUM)
         DFLD  'FLD004',LTH=40,
               POS=(2,11),ATTR=(PROT,NUM)
         FMTEND
         END
