         MFLD  'FLD011',LTH=8
         MFLD  'FLD012',LTH=40
         MFLD  'FLD013',LTH=20
         MSGEND
*
MFSHOLDV09I  FMT
         DEV   TYPE=(3270,2),FEAT=(IGNORE),DSCA=X'0020'
         DIV   TYPE=INOUT
         DFLD  'FLD000',LTH=10,
               POS=(1,1),ATTR=(PROT,NUM)
         DFLD  'FLD001',LTH=10,
               POS=(1,13),ATTR=(PROT,NUM)
