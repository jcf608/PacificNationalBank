*********************************************************************
* MFS for MFSHOLDV09
* Pacific National Bank — IMS/TM Message Format
*********************************************************************
         PRINT NOGEN
MFSHOLDV09M  MSG   TYPE=INPUT,SOR=(MFSHOLDV09I,IGNORE),
               NXT=MFSHOLDV09O
