         DFLD  'FLD007',LTH=12,
               POS=(3,1),ATTR=(PROT,NUM)
         DFLD  'FLD008',LTH=20,
               POS=(3,15),ATTR=(PROT,NUM)
         DFLD  'FLD009',LTH=10,
               POS=(3,37),ATTR=(PROT,NUM)
         DFLD  'FLD010',LTH=16,
