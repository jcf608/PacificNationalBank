*********************************************************************
* MFS for MFSALERV07
* Pacific National Bank — IMS/TM Message Format
*********************************************************************
         PRINT NOGEN
MFSALERV07M  MSG   TYPE=INPUT,SOR=(MFSALERV07I,IGNORE),
               NXT=MFSALERV07O
         SEG
         MFLD  'FLD000',LTH=30,
               JUST=R
         MFLD  'FLD001',LTH=10,
               JUST=L
         MFLD  'FLD002',LTH=8,
               JUST=R
         MFLD  'FLD003',LTH=8,
               JUST=R
         MFLD  'FLD004',LTH=30,
               JUST=L
         MFLD  'FLD005',LTH=40,
               JUST=L
         MFLD  'FLD006',LTH=20,
               JUST=R
         MFLD  'FLD007',LTH=12,
               JUST=R
         MFLD  'FLD008',LTH=20,
               JUST=L
         MFLD  'FLD009',LTH=10,
               JUST=L
         MFLD  'FLD010',LTH=16,
               JUST=R
         MFLD  'FLD011',LTH=20,
               JUST=L
         MSGEND
*
MFSALERV07O  MSG   TYPE=OUTPUT,SOR=(MFSALERV07D,IGNORE),
               NXT=MFSALERV07M
         SEG
         MFLD  'FLD000',LTH=30
         MFLD  'FLD001',LTH=10
         MFLD  'FLD002',LTH=8
         MFLD  'FLD003',LTH=8
         MFLD  'FLD004',LTH=30
