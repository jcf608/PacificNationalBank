         MFLD  'FLD006',LTH=20
         MFLD  'FLD007',LTH=12
         MFLD  'FLD008',LTH=20
         MFLD  'FLD009',LTH=10
         MFLD  'FLD010',LTH=16
         MFLD  'FLD011',LTH=20
         MSGEND
*
MFSALERV07I  FMT
         DEV   TYPE=(3270,2),FEAT=(IGNORE),DSCA=X'0020'
         DIV   TYPE=INOUT
         DFLD  'FLD000',LTH=30,
               POS=(1,1),ATTR=(PROT,NUM)
         DFLD  'FLD001',LTH=10,
               POS=(1,33),ATTR=(PROT,NUM)
         DFLD  'FLD002',LTH=8,
               POS=(1,45),ATTR=(PROT,NUM)
         DFLD  'FLD003',LTH=8,
               POS=(1,55),ATTR=(PROT,NUM)
         DFLD  'FLD004',LTH=30,
