*********************************************************************
* MFS for MFSTXNDV09
* Pacific National Bank — IMS/TM Message Format
*********************************************************************
         PRINT NOGEN
MFSTXNDV09M  MSG   TYPE=INPUT,SOR=(MFSTXNDV09I,IGNORE),
               NXT=MFSTXNDV09O
         SEG
         MFLD  'FLD000',LTH=8,
               JUST=L
         MFLD  'FLD001',LTH=12,
               JUST=L
