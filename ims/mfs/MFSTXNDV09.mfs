         MFLD  'FLD011',LTH=16
         MFLD  'FLD012',LTH=16
         MFLD  'FLD013',LTH=10
         MSGEND
*
MFSTXNDV09I  FMT
         DEV   TYPE=(3270,2),FEAT=(IGNORE),DSCA=X'0020'
         DIV   TYPE=INOUT
         DFLD  'FLD000',LTH=8,
               POS=(1,1),ATTR=(PROT,NUM)
         DFLD  'FLD001',LTH=12,
               POS=(1,11),ATTR=(PROT,NUM)
