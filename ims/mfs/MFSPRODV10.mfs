*********************************************************************
* MFS for MFSPRODV10
* Pacific National Bank — IMS/TM Message Format
*********************************************************************
         PRINT NOGEN
MFSPRODV10M  MSG   TYPE=INPUT,SOR=(MFSPRODV10I,IGNORE),
               NXT=MFSPRODV10O
         SEG
         MFLD  'FLD000',LTH=16,
               JUST=L
         MFLD  'FLD001',LTH=16,
               JUST=R
         MFLD  'FLD002',LTH=30,
               JUST=L
         MFLD  'FLD003',LTH=30,
               JUST=R
         MFLD  'FLD004',LTH=16,
               JUST=R
         MSGEND
*
MFSPRODV10O  MSG   TYPE=OUTPUT,SOR=(MFSPRODV10D,IGNORE),
               NXT=MFSPRODV10M
         SEG
         MFLD  'FLD000',LTH=16
         MFLD  'FLD001',LTH=16
         MFLD  'FLD002',LTH=30
         MFLD  'FLD003',LTH=30
         MFLD  'FLD004',LTH=16
         MSGEND
*
MFSPRODV10I  FMT
         DEV   TYPE=(3270,2),FEAT=(IGNORE),DSCA=X'0020'
         DIV   TYPE=INOUT
         DFLD  'FLD000',LTH=16,
               POS=(1,1),ATTR=(PROT,NUM)
         DFLD  'FLD001',LTH=16,
               POS=(1,19),ATTR=(PROT,NUM)
         DFLD  'FLD002',LTH=30,
               POS=(1,37),ATTR=(PROT,NUM)
         DFLD  'FLD003',LTH=30,
               POS=(1,69),ATTR=(PROT,NUM)
         DFLD  'FLD004',LTH=16,
               POS=(2,21),ATTR=(PROT,NUM)
         FMTEND
         END
