*********************************************************************
* MFS for MFSHOLDV07
* Pacific National Bank — IMS/TM Message Format
*********************************************************************
         PRINT NOGEN
MFSHOLDV07M  MSG   TYPE=INPUT,SOR=(MFSHOLDV07I,IGNORE),
               NXT=MFSHOLDV07O
