*********************************************************************
* MFS for MFSRATEV09
* Pacific National Bank — IMS/TM Message Format
*********************************************************************
         PRINT NOGEN
MFSRATEV09M  MSG   TYPE=INPUT,SOR=(MFSRATEV09I,IGNORE),
               NXT=MFSRATEV09O
         SEG
         MFLD  'FLD000',LTH=16,
               JUST=L
         MFLD  'FLD001',LTH=30,
               JUST=R
         MFLD  'FLD002',LTH=8,
               JUST=R
         MFLD  'FLD003',LTH=30,
               JUST=L
         MFLD  'FLD004',LTH=8,
               JUST=L
         MFLD  'FLD005',LTH=40,
               JUST=L
         MFLD  'FLD006',LTH=12,
               JUST=R
         MFLD  'FLD007',LTH=12,
               JUST=L
         MFLD  'FLD008',LTH=40,
               JUST=R
         MFLD  'FLD009',LTH=20,
               JUST=L
         MFLD  'FLD010',LTH=16,
               JUST=L
