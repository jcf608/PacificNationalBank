*********************************************************************
* MFS for MFSALERV12
* Pacific National Bank — IMS/TM Message Format
*********************************************************************
         PRINT NOGEN
MFSALERV12M  MSG   TYPE=INPUT,SOR=(MFSALERV12I,IGNORE),
               NXT=MFSALERV12O
         SEG
         MFLD  'FLD000',LTH=40,
               JUST=R
         MFLD  'FLD001',LTH=12,
               JUST=R
         MFLD  'FLD002',LTH=20,
               JUST=L
         MFLD  'FLD003',LTH=12,
               JUST=R
         MFLD  'FLD004',LTH=30,
               JUST=L
         MFLD  'FLD005',LTH=8,
               JUST=L
         MFLD  'FLD006',LTH=16,
               JUST=R
         MSGEND
*
MFSALERV12O  MSG   TYPE=OUTPUT,SOR=(MFSALERV12D,IGNORE),
               NXT=MFSALERV12M
         SEG
         MFLD  'FLD000',LTH=40
         MFLD  'FLD001',LTH=12
         MFLD  'FLD002',LTH=20
         MFLD  'FLD003',LTH=12
         MFLD  'FLD004',LTH=30
         MFLD  'FLD005',LTH=8
         MFLD  'FLD006',LTH=16
         MSGEND
*
MFSALERV12I  FMT
         DEV   TYPE=(3270,2),FEAT=(IGNORE),DSCA=X'0020'
         DIV   TYPE=INOUT
         DFLD  'FLD000',LTH=40,
               POS=(1,1),ATTR=(PROT,NUM)
         DFLD  'FLD001',LTH=12,
               POS=(1,43),ATTR=(PROT,NUM)
         DFLD  'FLD002',LTH=20,
               POS=(1,57),ATTR=(PROT,NUM)
         DFLD  'FLD003',LTH=12,
               POS=(1,79),ATTR=(PROT,NUM)
         DFLD  'FLD004',LTH=30,
               POS=(2,13),ATTR=(PROT,NUM)
         DFLD  'FLD005',LTH=8,
               POS=(2,45),ATTR=(PROT,NUM)
         DFLD  'FLD006',LTH=16,
               POS=(2,55),ATTR=(PROT,NUM)
         FMTEND
         END
