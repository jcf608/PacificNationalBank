         PRINT NOGEN
MFSWIREV06M  MSG   TYPE=INPUT,SOR=(MFSWIREV06I,IGNORE),
               NXT=MFSWIREV06O
         SEG
         MFLD  'FLD000',LTH=10,
               JUST=L
