               JUST=L
         MSGEND
*
MFSWIREV06O  MSG   TYPE=OUTPUT,SOR=(MFSWIREV06D,IGNORE),
               NXT=MFSWIREV06M
         SEG
         MFLD  'FLD000',LTH=10
         MFLD  'FLD001',LTH=16
