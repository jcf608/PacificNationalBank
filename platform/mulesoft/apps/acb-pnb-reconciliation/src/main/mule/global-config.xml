<?xml version="1.0" encoding="UTF-8"?>
<mule xmlns="http://www.mulesoft.org/schema/mule/core"
      xmlns:http="http://www.mulesoft.org/schema/mule/http"
      xmlns:doc="http://www.mulesoft.org/schema/mule/documentation"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:schemaLocation="
        http://www.mulesoft.org/schema/mule/core http://www.mulesoft.org/schema/mule/core/current/mule.xsd
        http://www.mulesoft.org/schema/mule/http http://www.mulesoft.org/schema/mule/http/current/mule-http.xsd">

    <http:listener-config name="reconciliation-http" doc:name="HTTP Listener">
        <http:listener-connection host="0.0.0.0" port="${http.port:8090}"/>
    </http:listener-config>

    <http:request-config name="pnb-azure-http" doc:name="PNB Azure">
        <http:request-connection host="${pnb.azure.host}" port="${pnb.azure.port}" protocol="HTTP"/>
    </http:request-config>

    <http:request-config name="acb-azure-http" doc:name="ACB Azure">
        <http:request-connection host="${acb.azure.host}" port="${acb.azure.port}" protocol="HTTP"/>
    </http:request-config>

    <configuration-properties file="config.properties"/>
</mule>
