/*********************************************************************/
/* PLTACH-06V01 — PL/I ACH-DEBIT Processing V1                                    */
/* Pacific National Bank — PL/I Transaction Processing              */
/*********************************************************************/

PLTACH-06V01: PROCEDURE OPTIONS(MAIN);

  /* Standard includes */
  %INCLUDE PNBACCT;
  %INCLUDE PNBCUST;
  %INCLUDE PNBTXN;
  %INCLUDE PNBERR;

  /* Module declarations */
  DCL program_name  CHAR(12) INIT('PLTACH-06V01');
  DCL return_code   FIXED BIN(31) INIT(0);
  DCL error_msg     CHAR(80) INIT('');
  DCL records_read  FIXED BIN(31) INIT(0);
  DCL records_ok    FIXED BIN(31) INIT(0);
  DCL records_err   FIXED BIN(31) INIT(0);
  DCL eof_flag      BIT(1) INIT('0'B);
  DCL (ADDR, LENGTH, SUBSTR, INDEX, VERIFY, TRANSLATE,
       DATETIME, TRIM, HIGH, LOW) BUILTIN;

  DCL input_buffer   CHAR(400);
  DCL output_buffer  CHAR(400);
  DCL INFILE         FILE RECORD INPUT;
  DCL OUTFILE        FILE RECORD OUTPUT;
  DCL ERRFILE        FILE RECORD OUTPUT;
  DCL txn_amount     FIXED DEC(15,2) INIT(0);
  DCL running_total  FIXED DEC(17,2) INIT(0);
  DCL daily_limit    FIXED DEC(13,2) INIT(50000.00);
  DCL auth_code      CHAR(10);
  DCL channel_code   CHAR(3);
  DCL work_field_001 FIXED DEC(15,2);
  DCL work_field_002 FIXED DEC(15,2);
  DCL work_field_003 FIXED DEC(15,2);
  DCL work_field_004 FIXED DEC(15,2);
  DCL batch_var_0002  FIXED DEC(15,2) INIT(0);
  DCL batch_str_0002  CHAR(40) INIT('');
  DCL batch_var_0003  FIXED DEC(15,2) INIT(0);
  DCL batch_str_0003  CHAR(40) INIT('');
  DCL batch_var_0004  FIXED DEC(15,2) INIT(0);
  DCL batch_str_0004  CHAR(40) INIT('');
  DCL batch_var_0005  FIXED DEC(15,2) INIT(0);
  DCL batch_str_0005  CHAR(40) INIT('');
  DCL batch_var_0006  FIXED DEC(15,2) INIT(0);
  DCL batch_str_0006  CHAR(40) INIT('');
  DCL batch_var_0007  FIXED DEC(15,2) INIT(0);
  DCL batch_str_0007  CHAR(40) INIT('');

  /* Main processing logic */
  CALL init_processing;
  DO WHILE (^eof_flag);
    CALL process_record;
  END;
  CALL finalize_processing;

  /*---------------------------------------------------------------*/
  /* process_record                                                    */
  /*---------------------------------------------------------------*/
  process_record: PROCEDURE;
    records_read = records_read + 1;
    CALL validate_ach_debit;
    IF return_code = 0 THEN DO;
      CALL authorize_ach_debit;
      IF return_code = 0 THEN DO;
        CALL post_ach_debit;
        records_ok = records_ok + 1;
      END;
      ELSE DO;
        CALL log_error('Authorization failed');
        records_err = records_err + 1;
      END;
    END;
    ELSE DO;
      CALL log_error('Validation failed');
      records_err = records_err + 1;
    END;
    READ FILE(INFILE) INTO(input_buffer);
  END process_record;

  /*---------------------------------------------------------------*/
  /* validate_ach_debit                                                    */
  /*---------------------------------------------------------------*/
  validate_ach_debit: PROCEDURE;
    return_code = 0;
    IF txn_amount <= 0 THEN DO;
      error_msg = 'Invalid amount';
      return_code = 8;
    END;
    IF VERIFY(SUBSTR(input_buffer,1,16), '0123456789') > 0 THEN DO;
      error_msg = 'Invalid account number';
      return_code = 8;
    END;
  END validate_ach_debit;

  /*---------------------------------------------------------------*/
  /* authorize_ach_debit                                                    */
  /*---------------------------------------------------------------*/
  authorize_ach_debit: PROCEDURE;
    return_code = 0;
    IF txn_amount > daily_limit THEN DO;
      error_msg = 'Exceeds daily limit';
      return_code = 4;
    END;
    running_total = running_total + txn_amount;
    auth_code = 'AUTH' || TRIM(CHAR(records_read));
  END authorize_ach_debit;

  /*---------------------------------------------------------------*/
  /* post_ach_debit                                                    */
  /*---------------------------------------------------------------*/
  post_ach_debit: PROCEDURE;
    output_buffer = input_buffer;
    WRITE FILE(OUTFILE) FROM(output_buffer);
    PUT SKIP LIST('ACH-DEBIT posted: ' || txn_amount);
  END post_ach_debit;

  /*---------------------------------------------------------------*/
  /* log_error                                                    */
  /*---------------------------------------------------------------*/
  log_error: PROCEDURE;
    DCL msg CHAR(80);
    WRITE FILE(ERRFILE) FROM(error_msg);
  END log_error;

  /*---------------------------------------------------------------*/
  /* variant_01_step_00                                                    */
  /*---------------------------------------------------------------*/
  variant_01_step_00: PROCEDURE;
    /* Variant 1 processing step 0 */
    batch_var_0002 = batch_var_0002 + 1;
    IF batch_var_0002 > 1000 THEN DO;
      PUT SKIP LIST('Threshold reached at ' || batch_var_0002);
    END;
    batch_var_0002 = batch_var_0002 + 2;
    IF batch_var_0002 > 2000 THEN DO;
      PUT SKIP LIST('Threshold reached at ' || batch_var_0002);
    END;
    batch_var_0002 = batch_var_0002 + 3;
    IF batch_var_0002 > 3000 THEN DO;
      PUT SKIP LIST('Threshold reached at ' || batch_var_0002);
    END;
    batch_var_0002 = batch_var_0002 + 4;
    IF batch_var_0002 > 4000 THEN DO;
      PUT SKIP LIST('Threshold reached at ' || batch_var_0002);
    END;
    batch_var_0002 = batch_var_0002 + 5;
    IF batch_var_0002 > 5000 THEN DO;
      PUT SKIP LIST('Threshold reached at ' || batch_var_0002);
    END;
    batch_var_0002 = batch_var_0002 + 6;
    IF batch_var_0002 > 6000 THEN DO;
      PUT SKIP LIST('Threshold reached at ' || batch_var_0002);
    END;
    batch_var_0002 = batch_var_0002 + 7;
    IF batch_var_0002 > 7000 THEN DO;
      PUT SKIP LIST('Threshold reached at ' || batch_var_0002);
    END;
    batch_var_0002 = batch_var_0002 + 8;
    IF batch_var_0002 > 8000 THEN DO;
      PUT SKIP LIST('Threshold reached at ' || batch_var_0002);
    END;
    batch_var_0002 = batch_var_0002 + 9;
    IF batch_var_0002 > 9000 THEN DO;
      PUT SKIP LIST('Threshold reached at ' || batch_var_0002);
    END;
    batch_var_0002 = batch_var_0002 + 10;
    IF batch_var_0002 > 10000 THEN DO;
      PUT SKIP LIST('Threshold reached at ' || batch_var_0002);
    END;
    batch_var_0002 = batch_var_0002 + 11;
    IF batch_var_0002 > 11000 THEN DO;
      PUT SKIP LIST('Threshold reached at ' || batch_var_0002);
    END;
    batch_var_0002 = batch_var_0002 + 12;
    IF batch_var_0002 > 12000 THEN DO;
      PUT SKIP LIST('Threshold reached at ' || batch_var_0002);
    END;
    batch_var_0002 = batch_var_0002 + 13;
    IF batch_var_0002 > 13000 THEN DO;
      PUT SKIP LIST('Threshold reached at ' || batch_var_0002);
    END;
    batch_var_0002 = batch_var_0002 + 14;
    IF batch_var_0002 > 14000 THEN DO;
      PUT SKIP LIST('Threshold reached at ' || batch_var_0002);
    END;
    batch_var_0002 = batch_var_0002 + 15;
    IF batch_var_0002 > 15000 THEN DO;
      PUT SKIP LIST('Threshold reached at ' || batch_var_0002);
    END;
    batch_var_0002 = batch_var_0002 + 16;
    IF batch_var_0002 > 16000 THEN DO;
      PUT SKIP LIST('Threshold reached at ' || batch_var_0002);
    END;
    batch_var_0002 = batch_var_0002 + 17;
    IF batch_var_0002 > 17000 THEN DO;
      PUT SKIP LIST('Threshold reached at ' || batch_var_0002);
    END;
    batch_var_0002 = batch_var_0002 + 18;
    IF batch_var_0002 > 18000 THEN DO;
      PUT SKIP LIST('Threshold reached at ' || batch_var_0002);
    END;
    batch_var_0002 = batch_var_0002 + 19;
    IF batch_var_0002 > 19000 THEN DO;
      PUT SKIP LIST('Threshold reached at ' || batch_var_0002);
    END;
    batch_var_0002 = batch_var_0002 + 20;
    IF batch_var_0002 > 20000 THEN DO;
      PUT SKIP LIST('Threshold reached at ' || batch_var_0002);
    END;
    batch_var_0002 = batch_var_0002 + 21;
    IF batch_var_0002 > 21000 THEN DO;
      PUT SKIP LIST('Threshold reached at ' || batch_var_0002);
    END;
    batch_var_0002 = batch_var_0002 + 22;
    IF batch_var_0002 > 22000 THEN DO;
      PUT SKIP LIST('Threshold reached at ' || batch_var_0002);
    END;
    batch_var_0002 = batch_var_0002 + 23;
    IF batch_var_0002 > 23000 THEN DO;
      PUT SKIP LIST('Threshold reached at ' || batch_var_0002);
    END;
    batch_var_0002 = batch_var_0002 + 24;
    IF batch_var_0002 > 24000 THEN DO;
      PUT SKIP LIST('Threshold reached at ' || batch_var_0002);
    END;
    batch_var_0002 = batch_var_0002 + 25;
    IF batch_var_0002 > 25000 THEN DO;
      PUT SKIP LIST('Threshold reached at ' || batch_var_0002);
    END;
  END variant_01_step_00;

  /*---------------------------------------------------------------*/
  /* variant_01_step_01                                                    */
  /*---------------------------------------------------------------*/
  variant_01_step_01: PROCEDURE;
    /* Variant 1 processing step 1 */
    batch_var_0002 = batch_var_0002 + 1;
    IF batch_var_0002 > 1000 THEN DO;
      PUT SKIP LIST('Threshold reached at ' || batch_var_0002);
    END;
    batch_var_0002 = batch_var_0002 + 2;
    IF batch_var_0002 > 2000 THEN DO;
      PUT SKIP LIST('Threshold reached at ' || batch_var_0002);
    END;
    batch_var_0002 = batch_var_0002 + 3;
    IF batch_var_0002 > 3000 THEN DO;
      PUT SKIP LIST('Threshold reached at ' || batch_var_0002);
    END;
    batch_var_0002 = batch_var_0002 + 4;
    IF batch_var_0002 > 4000 THEN DO;
      PUT SKIP LIST('Threshold reached at ' || batch_var_0002);
    END;
    batch_var_0002 = batch_var_0002 + 5;
    IF batch_var_0002 > 5000 THEN DO;
      PUT SKIP LIST('Threshold reached at ' || batch_var_0002);
    END;
    batch_var_0002 = batch_var_0002 + 6;
    IF batch_var_0002 > 6000 THEN DO;
      PUT SKIP LIST('Threshold reached at ' || batch_var_0002);
    END;
    batch_var_0002 = batch_var_0002 + 7;
    IF batch_var_0002 > 7000 THEN DO;
      PUT SKIP LIST('Threshold reached at ' || batch_var_0002);
    END;
    batch_var_0002 = batch_var_0002 + 8;
    IF batch_var_0002 > 8000 THEN DO;
      PUT SKIP LIST('Threshold reached at ' || batch_var_0002);
    END;
    batch_var_0002 = batch_var_0002 + 9;
    IF batch_var_0002 > 9000 THEN DO;
      PUT SKIP LIST('Threshold reached at ' || batch_var_0002);
    END;
    batch_var_0002 = batch_var_0002 + 10;
    IF batch_var_0002 > 10000 THEN DO;
      PUT SKIP LIST('Threshold reached at ' || batch_var_0002);
    END;
    batch_var_0002 = batch_var_0002 + 11;
    IF batch_var_0002 > 11000 THEN DO;
      PUT SKIP LIST('Threshold reached at ' || batch_var_0002);
    END;
    batch_var_0002 = batch_var_0002 + 12;
    IF batch_var_0002 > 12000 THEN DO;
      PUT SKIP LIST('Threshold reached at ' || batch_var_0002);
    END;
    batch_var_0002 = batch_var_0002 + 13;
    IF batch_var_0002 > 13000 THEN DO;
      PUT SKIP LIST('Threshold reached at ' || batch_var_0002);
    END;
    batch_var_0002 = batch_var_0002 + 14;
    IF batch_var_0002 > 14000 THEN DO;
      PUT SKIP LIST('Threshold reached at ' || batch_var_0002);
    END;
    batch_var_0002 = batch_var_0002 + 15;
    IF batch_var_0002 > 15000 THEN DO;
      PUT SKIP LIST('Threshold reached at ' || batch_var_0002);
    END;
    batch_var_0002 = batch_var_0002 + 16;
    IF batch_var_0002 > 16000 THEN DO;
      PUT SKIP LIST('Threshold reached at ' || batch_var_0002);
    END;
    batch_var_0002 = batch_var_0002 + 17;
    IF batch_var_0002 > 17000 THEN DO;
      PUT SKIP LIST('Threshold reached at ' || batch_var_0002);
    END;
    batch_var_0002 = batch_var_0002 + 18;
    IF batch_var_0002 > 18000 THEN DO;
      PUT SKIP LIST('Threshold reached at ' || batch_var_0002);
    END;
    batch_var_0002 = batch_var_0002 + 19;
    IF batch_var_0002 > 19000 THEN DO;
      PUT SKIP LIST('Threshold reached at ' || batch_var_0002);
    END;
    batch_var_0002 = batch_var_0002 + 20;
    IF batch_var_0002 > 20000 THEN DO;
      PUT SKIP LIST('Threshold reached at ' || batch_var_0002);
    END;
    batch_var_0002 = batch_var_0002 + 21;
    IF batch_var_0002 > 21000 THEN DO;
      PUT SKIP LIST('Threshold reached at ' || batch_var_0002);
    END;
    batch_var_0002 = batch_var_0002 + 22;
    IF batch_var_0002 > 22000 THEN DO;
      PUT SKIP LIST('Threshold reached at ' || batch_var_0002);
    END;
    batch_var_0002 = batch_var_0002 + 23;
    IF batch_var_0002 > 23000 THEN DO;
      PUT SKIP LIST('Threshold reached at ' || batch_var_0002);
    END;
    batch_var_0002 = batch_var_0002 + 24;
    IF batch_var_0002 > 24000 THEN DO;
      PUT SKIP LIST('Threshold reached at ' || batch_var_0002);
    END;
    batch_var_0002 = batch_var_0002 + 25;
    IF batch_var_0002 > 25000 THEN DO;
      PUT SKIP LIST('Threshold reached at ' || batch_var_0002);
    END;
  END variant_01_step_01;

  init_processing: PROCEDURE;
    PUT SKIP LIST(program_name || ' started at ' || DATETIME());
    OPEN FILE(INFILE) INPUT;
    OPEN FILE(OUTFILE) OUTPUT;
    OPEN FILE(ERRFILE) OUTPUT;
    ON ENDFILE(INFILE) eof_flag = '1'B;
    READ FILE(INFILE) INTO(input_buffer);
  END init_processing;

  finalize_processing: PROCEDURE;
    CLOSE FILE(INFILE);
    CLOSE FILE(OUTFILE);
    CLOSE FILE(ERRFILE);
    PUT SKIP LIST(program_name || ' complete.');
    PUT SKIP LIST('Records read:    ' || records_read);
    PUT SKIP LIST('Records OK:      ' || records_ok);
    PUT SKIP LIST('Records error:   ' || records_err);
    IF records_err > 0 THEN return_code = 4;
  END finalize_processing;

END PLTACH-06V01;
