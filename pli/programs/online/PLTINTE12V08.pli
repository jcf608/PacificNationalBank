    END;
    batch_var_0016 = batch_var_0016 + 16;
    IF batch_var_0016 > 16000 THEN DO;
      PUT SKIP LIST('Threshold reached at ' || batch_var_0016);
    END;
    batch_var_0016 = batch_var_0016 + 17;
    IF batch_var_0016 > 17000 THEN DO;
