/*********************************************************************/
/* PLTINTE12V08 — PL/I INTEREST Processing V8                                    */
/* Pacific National Bank — PL/I Transaction Processing              */
/*********************************************************************/

PLTINTE12V08: PROCEDURE OPTIONS(MAIN);

  /* Standard includes */
  %INCLUDE PNBACCT;
  %INCLUDE PNBCUST;
  %INCLUDE PNBTXN;
  %INCLUDE PNBERR;

  /* Module declarations */
  DCL program_name  CHAR(12) INIT('PLTINTE12V08');
  DCL return_code   FIXED BIN(31) INIT(0);
  DCL error_msg     CHAR(80) INIT('');
  DCL records_read  FIXED BIN(31) INIT(0);
  DCL records_ok    FIXED BIN(31) INIT(0);
  DCL records_err   FIXED BIN(31) INIT(0);
  DCL eof_flag      BIT(1) INIT('0'B);
  DCL (ADDR, LENGTH, SUBSTR, INDEX, VERIFY, TRANSLATE,
       DATETIME, TRIM, HIGH, LOW) BUILTIN;

  DCL input_buffer   CHAR(400);
  DCL output_buffer  CHAR(400);
  DCL INFILE         FILE RECORD INPUT;
  DCL OUTFILE        FILE RECORD OUTPUT;
  DCL ERRFILE        FILE RECORD OUTPUT;
  DCL txn_amount     FIXED DEC(15,2) INIT(0);
  DCL running_total  FIXED DEC(17,2) INIT(0);
  DCL daily_limit    FIXED DEC(13,2) INIT(50000.00);
  DCL auth_code      CHAR(10);
  DCL channel_code   CHAR(3);
  DCL work_field_001 FIXED DEC(15,2);
  DCL work_field_002 FIXED DEC(15,2);
  DCL batch_var_0016  FIXED DEC(15,2) INIT(0);
  DCL batch_str_0016  CHAR(40) INIT('');
  DCL batch_var_0017  FIXED DEC(15,2) INIT(0);
  DCL batch_str_0017  CHAR(40) INIT('');
  DCL batch_var_0018  FIXED DEC(15,2) INIT(0);
  DCL batch_str_0018  CHAR(40) INIT('');
  DCL batch_var_0019  FIXED DEC(15,2) INIT(0);
  DCL batch_str_0019  CHAR(40) INIT('');
  DCL batch_var_0020  FIXED DEC(15,2) INIT(0);
  DCL batch_str_0020  CHAR(40) INIT('');
  DCL batch_var_0021  FIXED DEC(15,2) INIT(0);
  DCL batch_str_0021  CHAR(40) INIT('');

  /* Main processing logic */
  CALL init_processing;
  DO WHILE (^eof_flag);
    CALL process_record;
  END;
  CALL finalize_processing;

  /*---------------------------------------------------------------*/
  /* process_record                                                    */
  /*---------------------------------------------------------------*/
  process_record: PROCEDURE;
    records_read = records_read + 1;
    CALL validate_interest;
    IF return_code = 0 THEN DO;
      CALL authorize_interest;
      IF return_code = 0 THEN DO;
        CALL post_interest;
        records_ok = records_ok + 1;
      END;
      ELSE DO;
        CALL log_error('Authorization failed');
        records_err = records_err + 1;
      END;
    END;
    ELSE DO;
      CALL log_error('Validation failed');
      records_err = records_err + 1;
    END;
    READ FILE(INFILE) INTO(input_buffer);
  END process_record;

  /*---------------------------------------------------------------*/
  /* validate_interest                                                    */
  /*---------------------------------------------------------------*/
  validate_interest: PROCEDURE;
    return_code = 0;
    IF txn_amount <= 0 THEN DO;
      error_msg = 'Invalid amount';
      return_code = 8;
    END;
    IF VERIFY(SUBSTR(input_buffer,1,16), '0123456789') > 0 THEN DO;
      error_msg = 'Invalid account number';
      return_code = 8;
    END;
  END validate_interest;

  /*---------------------------------------------------------------*/
  /* authorize_interest                                                    */
  /*---------------------------------------------------------------*/
  authorize_interest: PROCEDURE;
    return_code = 0;
    IF txn_amount > daily_limit THEN DO;
      error_msg = 'Exceeds daily limit';
      return_code = 4;
    END;
    running_total = running_total + txn_amount;
    auth_code = 'AUTH' || TRIM(CHAR(records_read));
  END authorize_interest;

  /*---------------------------------------------------------------*/
  /* post_interest                                                    */
  /*---------------------------------------------------------------*/
  post_interest: PROCEDURE;
    output_buffer = input_buffer;
    WRITE FILE(OUTFILE) FROM(output_buffer);
    PUT SKIP LIST('INTEREST posted: ' || txn_amount);
  END post_interest;

  /*---------------------------------------------------------------*/
  /* log_error                                                    */
  /*---------------------------------------------------------------*/
  log_error: PROCEDURE;
    DCL msg CHAR(80);
    WRITE FILE(ERRFILE) FROM(error_msg);
  END log_error;

  /*---------------------------------------------------------------*/
  /* variant_08_step_00                                                    */
  /*---------------------------------------------------------------*/
  variant_08_step_00: PROCEDURE;
    /* Variant 8 processing step 0 */
    batch_var_0016 = batch_var_0016 + 1;
    IF batch_var_0016 > 1000 THEN DO;
      PUT SKIP LIST('Threshold reached at ' || batch_var_0016);
    END;
    batch_var_0016 = batch_var_0016 + 2;
    IF batch_var_0016 > 2000 THEN DO;
      PUT SKIP LIST('Threshold reached at ' || batch_var_0016);
    END;
    batch_var_0016 = batch_var_0016 + 3;
    IF batch_var_0016 > 3000 THEN DO;
      PUT SKIP LIST('Threshold reached at ' || batch_var_0016);
    END;
    batch_var_0016 = batch_var_0016 + 4;
    IF batch_var_0016 > 4000 THEN DO;
      PUT SKIP LIST('Threshold reached at ' || batch_var_0016);
    END;
    batch_var_0016 = batch_var_0016 + 5;
    IF batch_var_0016 > 5000 THEN DO;
      PUT SKIP LIST('Threshold reached at ' || batch_var_0016);
    END;
    batch_var_0016 = batch_var_0016 + 6;
    IF batch_var_0016 > 6000 THEN DO;
