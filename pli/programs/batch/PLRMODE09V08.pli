    END;
    batch_var_0016 = batch_var_0016 + 10;
    IF batch_var_0016 > 10000 THEN DO;
      PUT SKIP LIST('Threshold reached at ' || batch_var_0016);
    END;
    batch_var_0016 = batch_var_0016 + 11;
