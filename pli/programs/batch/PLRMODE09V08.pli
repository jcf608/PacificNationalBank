      PUT SKIP LIST('Threshold reached at ' || batch_var_0016);
    END;
    batch_var_0016 = batch_var_0016 + 19;
    IF batch_var_0016 > 19000 THEN DO;
      PUT SKIP LIST('Threshold reached at ' || batch_var_0016);
    END;
    batch_var_0016 = batch_var_0016 + 20;
    IF batch_var_0016 > 20000 THEN DO;
      PUT SKIP LIST('Threshold reached at ' || batch_var_0016);
    END;
    batch_var_0016 = batch_var_0016 + 21;
    IF batch_var_0016 > 21000 THEN DO;
      PUT SKIP LIST('Threshold reached at ' || batch_var_0016);
    END;
    batch_var_0016 = batch_var_0016 + 22;
    IF batch_var_0016 > 22000 THEN DO;
      PUT SKIP LIST('Threshold reached at ' || batch_var_0016);
    END;
    batch_var_0016 = batch_var_0016 + 23;
    IF batch_var_0016 > 23000 THEN DO;
      PUT SKIP LIST('Threshold reached at ' || batch_var_0016);
    END;
    batch_var_0016 = batch_var_0016 + 24;
    IF batch_var_0016 > 24000 THEN DO;
      PUT SKIP LIST('Threshold reached at ' || batch_var_0016);
    END;
    batch_var_0016 = batch_var_0016 + 25;
    IF batch_var_0016 > 25000 THEN DO;
      PUT SKIP LIST('Threshold reached at ' || batch_var_0016);
    END;
  END variant_08_step_01;

  /*---------------------------------------------------------------*/
  /* variant_08_step_02                                                    */
  /*---------------------------------------------------------------*/
  variant_08_step_02: PROCEDURE;
    /* Variant 8 processing step 2 */
    batch_var_0016 = batch_var_0016 + 1;
    IF batch_var_0016 > 1000 THEN DO;
      PUT SKIP LIST('Threshold reached at ' || batch_var_0016);
    END;
    batch_var_0016 = batch_var_0016 + 2;
    IF batch_var_0016 > 2000 THEN DO;
      PUT SKIP LIST('Threshold reached at ' || batch_var_0016);
    END;
    batch_var_0016 = batch_var_0016 + 3;
    IF batch_var_0016 > 3000 THEN DO;
      PUT SKIP LIST('Threshold reached at ' || batch_var_0016);
    END;
    batch_var_0016 = batch_var_0016 + 4;
    IF batch_var_0016 > 4000 THEN DO;
      PUT SKIP LIST('Threshold reached at ' || batch_var_0016);
    END;
    batch_var_0016 = batch_var_0016 + 5;
    IF batch_var_0016 > 5000 THEN DO;
      PUT SKIP LIST('Threshold reached at ' || batch_var_0016);
    END;
    batch_var_0016 = batch_var_0016 + 6;
    IF batch_var_0016 > 6000 THEN DO;
      PUT SKIP LIST('Threshold reached at ' || batch_var_0016);
    END;
    batch_var_0016 = batch_var_0016 + 7;
