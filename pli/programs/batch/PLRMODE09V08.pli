/*********************************************************************/
/* PLRMODE09V08 — PL/I MODEL Risk Analytics V8                                    */
/* Pacific National Bank — PL/I Transaction Processing              */
/*********************************************************************/

PLRMODE09V08: PROCEDURE OPTIONS(MAIN);

  /* Standard includes */
  %INCLUDE PNBACCT;
  %INCLUDE PNBCUST;
  %INCLUDE PNBTXN;
  %INCLUDE PNBERR;

  /* Module declarations */
  DCL program_name  CHAR(12) INIT('PLRMODE09V08');
  DCL return_code   FIXED BIN(31) INIT(0);
  DCL error_msg     CHAR(80) INIT('');
  DCL records_read  FIXED BIN(31) INIT(0);
  DCL records_ok    FIXED BIN(31) INIT(0);
  DCL records_err   FIXED BIN(31) INIT(0);
  DCL eof_flag      BIT(1) INIT('0'B);
  DCL (ADDR, LENGTH, SUBSTR, INDEX, VERIFY, TRANSLATE,
       DATETIME, TRIM, HIGH, LOW) BUILTIN;

  DCL input_buffer   CHAR(600);
  DCL output_buffer  CHAR(600);
  DCL INFILE         FILE RECORD INPUT;
  DCL OUTFILE        FILE RECORD OUTPUT;
  DCL ERRFILE        FILE RECORD OUTPUT;
  DCL risk_score     FIXED DEC(5,2) INIT(0);
  DCL threshold      FIXED DEC(5,2) INIT(75.00);
  DCL exposure       FIXED DEC(17,2) INIT(0);
  DCL max_exposure   FIXED DEC(17,2) INIT(0);
  DCL probability    FLOAT DEC(16) INIT(0);
  DCL loss_given_def FLOAT DEC(16) INIT(0);
  DCL expected_loss  FIXED DEC(17,2) INIT(0);
  DCL risk_factor_01 FLOAT DEC(16);
  DCL risk_factor_02 FLOAT DEC(16);
  DCL risk_factor_03 FLOAT DEC(16);
  DCL risk_factor_04 FLOAT DEC(16);
  DCL batch_var_0016  FIXED DEC(15,2) INIT(0);
  DCL batch_str_0016  CHAR(40) INIT('');
  DCL batch_var_0017  FIXED DEC(15,2) INIT(0);
  DCL batch_str_0017  CHAR(40) INIT('');
  DCL batch_var_0018  FIXED DEC(15,2) INIT(0);
  DCL batch_str_0018  CHAR(40) INIT('');
  DCL batch_var_0019  FIXED DEC(15,2) INIT(0);
  DCL batch_str_0019  CHAR(40) INIT('');
  DCL batch_var_0020  FIXED DEC(15,2) INIT(0);
  DCL batch_str_0020  CHAR(40) INIT('');
  DCL batch_var_0021  FIXED DEC(15,2) INIT(0);
  DCL batch_str_0021  CHAR(40) INIT('');

  /* Main processing logic */
  CALL init_processing;
  DO WHILE (^eof_flag);
    CALL process_record;
  END;
  CALL finalize_processing;

  /*---------------------------------------------------------------*/
  /* process_record                                                    */
  /*---------------------------------------------------------------*/
  process_record: PROCEDURE;
    records_read = records_read + 1;
    CALL parse_model_data;
    CALL calculate_model_score;
    IF risk_score > threshold THEN
      CALL flag_high_risk;
    CALL write_result;
    records_ok = records_ok + 1;
    READ FILE(INFILE) INTO(input_buffer);
  END process_record;

  /*---------------------------------------------------------------*/
  /* parse_model_data                                                    */
  /*---------------------------------------------------------------*/
  parse_model_data: PROCEDURE;
    /* Parse input record into risk fields */
    exposure = 0;
    probability = 0;
    loss_given_def = 0;
  END parse_model_data;

  /*---------------------------------------------------------------*/
  /* calculate_model_score                                                    */
  /*---------------------------------------------------------------*/
  calculate_model_score: PROCEDURE;
    /* MODEL risk scoring model */
    expected_loss = exposure * probability * loss_given_def;
    risk_score = (expected_loss / exposure) * 100;
    IF risk_score > 100 THEN risk_score = 100;
    IF risk_score < 0 THEN risk_score = 0;
  END calculate_model_score;

  /*---------------------------------------------------------------*/
  /* flag_high_risk                                                    */
  /*---------------------------------------------------------------*/
  flag_high_risk: PROCEDURE;
    PUT SKIP LIST('HIGH RISK: score=' || risk_score
      || ' exposure=' || exposure);
  END flag_high_risk;

  /*---------------------------------------------------------------*/
  /* write_result                                                    */
  /*---------------------------------------------------------------*/
  write_result: PROCEDURE;
    output_buffer = input_buffer;
    WRITE FILE(OUTFILE) FROM(output_buffer);
  END write_result;

  /*---------------------------------------------------------------*/
  /* variant_08_step_00                                                    */
  /*---------------------------------------------------------------*/
  variant_08_step_00: PROCEDURE;
    /* Variant 8 processing step 0 */
    batch_var_0016 = batch_var_0016 + 1;
    IF batch_var_0016 > 1000 THEN DO;
      PUT SKIP LIST('Threshold reached at ' || batch_var_0016);
    END;
    batch_var_0016 = batch_var_0016 + 2;
    IF batch_var_0016 > 2000 THEN DO;
      PUT SKIP LIST('Threshold reached at ' || batch_var_0016);
    END;
    batch_var_0016 = batch_var_0016 + 3;
    IF batch_var_0016 > 3000 THEN DO;
      PUT SKIP LIST('Threshold reached at ' || batch_var_0016);
    END;
    batch_var_0016 = batch_var_0016 + 4;
    IF batch_var_0016 > 4000 THEN DO;
      PUT SKIP LIST('Threshold reached at ' || batch_var_0016);
    END;
    batch_var_0016 = batch_var_0016 + 5;
    IF batch_var_0016 > 5000 THEN DO;
      PUT SKIP LIST('Threshold reached at ' || batch_var_0016);
    END;
    batch_var_0016 = batch_var_0016 + 6;
    IF batch_var_0016 > 6000 THEN DO;
      PUT SKIP LIST('Threshold reached at ' || batch_var_0016);
    END;
    batch_var_0016 = batch_var_0016 + 7;
    IF batch_var_0016 > 7000 THEN DO;
      PUT SKIP LIST('Threshold reached at ' || batch_var_0016);
    END;
    batch_var_0016 = batch_var_0016 + 8;
    IF batch_var_0016 > 8000 THEN DO;
      PUT SKIP LIST('Threshold reached at ' || batch_var_0016);
    END;
    batch_var_0016 = batch_var_0016 + 9;
    IF batch_var_0016 > 9000 THEN DO;
      PUT SKIP LIST('Threshold reached at ' || batch_var_0016);
    END;
    batch_var_0016 = batch_var_0016 + 10;
    IF batch_var_0016 > 10000 THEN DO;
      PUT SKIP LIST('Threshold reached at ' || batch_var_0016);
    END;
    batch_var_0016 = batch_var_0016 + 11;
    IF batch_var_0016 > 11000 THEN DO;
      PUT SKIP LIST('Threshold reached at ' || batch_var_0016);
    END;
    batch_var_0016 = batch_var_0016 + 12;
    IF batch_var_0016 > 12000 THEN DO;
      PUT SKIP LIST('Threshold reached at ' || batch_var_0016);
    END;
    batch_var_0016 = batch_var_0016 + 13;
    IF batch_var_0016 > 13000 THEN DO;
      PUT SKIP LIST('Threshold reached at ' || batch_var_0016);
    END;
    batch_var_0016 = batch_var_0016 + 14;
    IF batch_var_0016 > 14000 THEN DO;
