    END;
    batch_var_0016 = batch_var_0016 + 24;
    IF batch_var_0016 > 24000 THEN DO;
      PUT SKIP LIST('Threshold reached at ' || batch_var_0016);
    END;
    batch_var_0016 = batch_var_0016 + 25;
    IF batch_var_0016 > 25000 THEN DO;
      PUT SKIP LIST('Threshold reached at ' || batch_var_0016);
    END;
  END variant_08_step_02;

  init_processing: PROCEDURE;
    PUT SKIP LIST(program_name || ' started at ' || DATETIME());
    OPEN FILE(INFILE) INPUT;
    OPEN FILE(OUTFILE) OUTPUT;
    OPEN FILE(ERRFILE) OUTPUT;
    ON ENDFILE(INFILE) eof_flag = '1'B;
    READ FILE(INFILE) INTO(input_buffer);
  END init_processing;

  finalize_processing: PROCEDURE;
    CLOSE FILE(INFILE);
    CLOSE FILE(OUTFILE);
    CLOSE FILE(ERRFILE);
    PUT SKIP LIST(program_name || ' complete.');
    PUT SKIP LIST('Records read:    ' || records_read);
    PUT SKIP LIST('Records OK:      ' || records_ok);
    PUT SKIP LIST('Records error:   ' || records_err);
    IF records_err > 0 THEN return_code = 4;
  END finalize_processing;

END PLRMODE09V08;
